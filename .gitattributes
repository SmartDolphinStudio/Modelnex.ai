# Normalize line endings and mark binary assets.
# https://git-scm.com/docs/gitattributes

# Auto-detect text files and enforce LF in the working tree.
* text=auto eol=lf

# Explicit text sources.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Windows-only files keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files must never be normalized or diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  text eol=lf
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary

# Internal files are irrelevant for source archives.
.gitignore     export-ignore
.gitattributes export-ignore
.editorconfig  export-ignore
